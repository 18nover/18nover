# Sites server routes (never prefix these with NEXT_PUBLIC_)
SITES_ORIGIN=https://18nover.example.chatgpt.site
NOVER_RELAY_ORIGIN=https://stream.example.com
NOVER_RELAY_HMAC_KEY_ID=sites-v1
NOVER_RELAY_HMAC_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-secret
NOVER_HOST_USER_IDS=replace-with-sites-user-id
NOVER_MODERATOR_USER_IDS=
NOVER_MEMBER_USER_IDS=replace-with-comma-separated-sites-user-ids
NOVER_RELAY_TIMEOUT_MS=10000

# Explicit local preview identity. Never enable these in production.
NOVER_DEV_AUTH_ENABLED=false
NOVER_DEV_USER_ID=local-preview
NOVER_DEV_USER_NAME=Local Host
NOVER_DEV_USER_ROLE=host
