# Sites server routes (never prefix these with NEXT_PUBLIC_)
SITES_ORIGIN=https://lockard-live.example.chatgpt.site
LOCKARD_RELAY_ORIGIN=https://stream.example.com
LOCKARD_RELAY_HMAC_KEY_ID=sites-v1
LOCKARD_RELAY_HMAC_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-secret
LOCKARD_HOST_USER_IDS=replace-with-sites-user-id
LOCKARD_MODERATOR_USER_IDS=
LOCKARD_MEMBER_USER_IDS=replace-with-comma-separated-sites-user-ids
LOCKARD_RELAY_TIMEOUT_MS=10000

# Explicit local preview identity. Never enable these in production.
LOCKARD_DEV_AUTH_ENABLED=false
LOCKARD_DEV_USER_ID=local-preview
LOCKARD_DEV_USER_NAME=Local Host
LOCKARD_DEV_USER_ROLE=host
