{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "18nover",
  "account_id": "08ebf9a3aa8639d7485803525c77179f",
  // Set to the deploy day. Do not add nodejs_compat by hand.
  "compatibility_date": "2026-11-21",
  // Preview only: workers.dev. Do not add routes or custom domains here
